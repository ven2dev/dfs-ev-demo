# Server-only — do NOT prefix with NEXT_PUBLIC_, or Next.js will inline
# this into the client bundle. Only server-side code (API routes, the
# server-side odds poller) should ever read this.
ODDS_API_KEY=

# Server-only data-source boundary for all odds-backed routes. Production
# accepts only "live" and temporarily defaults to it during the #58 rollout.
# Vercel Preview accepts only "fixture" and defaults to it. Local development
# defaults to fixtures; set "live" explicitly (with ODDS_API_KEY) only for a
# deliberate provider-backed verification.
ODDS_DATA_SOURCE=fixture

# Firebase web app config — safe to expose client-side (NEXT_PUBLIC_),
# these identify the project, they are not secrets. From Firebase console:
# Settings > Project settings > General > Your apps > (web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only) — a service account key, a real secret,
# NOT the same thing as the web app config above. From Firebase console:
# Project settings > Service accounts > Generate new private key. Base64-
# encode the downloaded JSON file's contents before pasting it here, since
# the raw JSON's private key contains literal newlines that .env parsers
# and some dashboards mangle:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# Server-only — Neon Postgres connection string (historical player
# stats: player_game_stats, sync_state, player_crosswalk). Provision via
# the Vercel dashboard's Storage tab (Create Database > Neon), or an
# existing Neon project's own dashboard. See README.md's "Historical
# player stats" section for schema/seed setup. Without this set,
# /api/stream falls back to seeded mock data rather than failing.
DATABASE_URL=

# Server-only — shared secret authorizing /api/cron/sync-player-stats.
# Vercel Cron sends this automatically as `Authorization: Bearer
# $CRON_SECRET` on its scheduled invocation; generate any random value
# (e.g. `openssl rand -hex 32`) and set the same value in both this
# file and the Vercel project's env vars.
CRON_SECRET=

# Server-only — authorizes the read-only odds-collector health endpoint.
# Keep this independent from CRON_SECRET so monitoring can never invoke
# collection or consume provider quota.
ODDS_HEALTH_SECRET=

# Server-only — dedicated bearer secret for the read-only database readiness
# endpoint. Keep separate from CRON_SECRET and ODDS_HEALTH_SECRET. Readiness
# cannot create/adopt a ledger or execute migrations.
DB_READINESS_SECRET=

# Server-only — controls the append-only odds observation collector (#41).
# Leave disabled during local development. Before enabling on a server, verify
# the required schema through docs/database-migrations.md; db/schema.sql is a
# generated reference, and hosted migration activation remains separately gated.
# free-pilot records the latest Sunday game (or ODDS_FREE_PILOT_EVENT_ID);
# paid-baseline records every event in the current NFL slate. An explicit
# free-pilot event id must belong to the current NFL week; update or clear it
# at weekly rollover or the collector deliberately fails closed.
ODDS_COLLECTION_PROFILE=disabled
ODDS_FREE_PILOT_EVENT_ID=

# Optional collector tuning. These defaults are shown explicitly so deployment
# configuration can be reviewed without reading the route implementation.
ODDS_COLLECTION_EVENING_HOUR_ET=20
ODDS_COLLECTION_LEASE_MS=45000
ODDS_COLLECTION_CLAIM_LIMIT=2
ODDS_COLLECTION_REQUEST_TIMEOUT_MS=15000
ODDS_COLLECTION_RETRY_DELAY_MS=60000
ODDS_COLLECTION_QUOTA_RESERVE=100
ODDS_PRIORITY_FAR_INTERVAL_MS=3600000
ODDS_PRIORITY_ACTIVE_INTERVAL_MS=300000

# Server-only — gates the internal creator-submission tool (#34) to a
# single owner account. Your own Firebase Auth uid (Firebase console >
# Authentication > Users, or read `uid` off the decoded ID token) — not
# a secret in the credential sense, just an identifier, but keep it
# server-only regardless since it defines who has write access to this
# tool.
ADMIN_UID=
