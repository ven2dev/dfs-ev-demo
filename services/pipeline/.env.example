# Owner-only inputs for the explicit synthetic R2 contract. Account, bucket and
# access key ID are identifiers; R2_SECRET_ACCESS_KEY is a credential.
# Setup/handling: docs/secrets-inventory.md and docs/secrets-delivery-design.md
# (from repo root). No permission for hosted feature-store or real-data writes
# follows from this template. Values stay outside source and agent sessions.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
