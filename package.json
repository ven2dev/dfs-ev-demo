{
  "name": "dfs-ev-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/web.mjs dev",
    "build": "node scripts/web.mjs build",
    "start": "node scripts/web.mjs start",
    "lint": "eslint",
    "typecheck": "npm run db:readiness:check && node scripts/web.mjs typegen && tsc --noEmit",
    "test": "npm run test:firebase-admin-runtime && vitest run --config vitest.config.ts && vitest run --config vitest.node.config.ts",
    "test:firebase-admin-runtime": "node --no-experimental-require-module -e \"require('firebase-admin/auth')\"",
    "test:firestore-rules": "npm run test:firestore-rules --workspace @dfs-ev/web --",
    "test:ci-gate": "node --test tests/ciGate.check.mjs tests/monorepo-layout.check.mjs",
    "test:db": "node packages/db/scripts/test-db.mjs run",
    "test:db:local": "node packages/db/scripts/test-db.mjs local",
    "test:db:repeat": "node packages/db/scripts/test-db.mjs repeat",
    "test:db:down": "node packages/db/scripts/test-db.mjs down",
    "test:db:guard": "node --test packages/db/tests/target.check.mjs packages/db/tests/bootstrap-unit.check.mjs packages/db/tests/report-unit.check.mjs packages/db/tests/readiness-manifest-unit.check.mjs packages/db/tests/templates-unit.check.mjs packages/db/tests/lanes-unit.check.mjs packages/db/tests/lifecycle-unit.check.mjs",
    "test:db:lifecycle": "node --test packages/db/tests/lifecycle.integration.check.mjs",
    "test:db:startup": "node --test packages/db/tests/startup.integration.check.mjs",
    "test:db:templates": "node --test packages/db/tests/templates.integration.check.mjs",
    "db:catalog": "node packages/db/scripts/db-catalog.mjs",
    "db:catalog:diff": "node packages/db/scripts/compare-db-catalog.mjs",
    "test:db:catalog:unit": "node --test packages/db/tests/catalog-unit.check.mjs",
    "test:db:catalog": "node --test packages/db/tests/catalog.integration.check.mjs",
    "db:contracts:generate": "node packages/db/scripts/db-catalog-contracts.mjs generate",
    "db:contracts:check": "node packages/db/scripts/db-catalog-contracts.mjs check",
    "test:db:contracts:unit": "node --test packages/db/tests/contracts-unit.check.mjs",
    "test:db:contracts": "node --test packages/db/tests/contracts.integration.check.mjs",
    "db:migrations:generate": "node packages/db/scripts/db-migration-artifacts.mjs generate",
    "db:migrations:check": "node packages/db/scripts/db-migration-artifacts.mjs check",
    "db:readiness:generate": "node packages/db/scripts/db-readiness-manifest.mjs generate",
    "db:readiness:check": "node packages/db/scripts/db-readiness-manifest.mjs check",
    "db:migrate": "node packages/db/scripts/db-migrate.mjs",
    "db:migrate:dev": "node packages/db/scripts/db-migrate-dev.mjs",
    "test:db:migrations:unit": "node --test packages/db/tests/migrations-unit.check.mjs",
    "test:db:migrations": "node --test packages/db/tests/migrations.integration.check.mjs",
    "test:db:plans:unit": "node --test packages/db/tests/plans-unit.check.mjs",
    "test:db:plans": "node --test packages/db/tests/plans.integration.check.mjs",
    "creators": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON services/pipeline/scripts/creator-corpus/cli.ts",
    "projection:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON packages/domain/scripts/projection/demo.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:feature-store:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 services/pipeline/tests/feature-store/*.check.mts",
    "feature-store:ingest:spike": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON services/pipeline/scripts/feature-store/ingest-spike.ts",
    "feature-store:derived:spike": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON services/pipeline/scripts/feature-store/derived-spike.ts",
    "feature-store:dataset:spike": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON services/pipeline/scripts/feature-store/dataset-spike.ts",
    "test:repo-layout": "node --test tests/monorepo-layout.check.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "csv-parse": "7.0.3",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zustand": "5.0.15",
    "@next/env": "16.4.2"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.3",
    "pg": "8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
